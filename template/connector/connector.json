{
  "$schema": "https://raw.githubusercontent.com/superfly/sprites-connectors/main/v1/schema.json",
  "format_version": 1,
  "name": "example",
  "display_name": "Example",
  "base_url": "https://api.example.com",
  "description": "One line for the connector picker",
  "long_description": "What a Sprite can do through this connector, what the key check does, and what is not forwarded.",
  "website_url": "https://example.com/settings/api-keys",
  "auth": {"header": "x-api-key"},
  "allowed_paths": [
    {"methods": ["POST"], "pattern": "/v1/search"},
    {"methods": ["GET"], "pattern": "/v1/items/:id"}
  ],
  "forward_response_headers": ["x-request-id", "retry-after"],
  "probe": {
    "method": "GET",
    "path": "/v1/me",
    "label": "account",
    "expect": [["id", "text"], ["error", "absent"]],
    "errors": [{"status": 403, "reason": "invalid_api_key"}]
  },
  "examples": [
    {"title": "Search (uses your Example credits)", "method": "POST", "path": "/v1/search", "json": {"q": "sprites"}},
    {"title": "Read one item; replace ITEM_ID", "path": "/v1/items/ITEM_ID"}
  ],
  "messages": {
    "402": "Example credits exhausted",
    "429": "Example rate limit reached; try again later"
  },
  "discovery": {"categories": ["search"], "keywords": ["web search"]},
  "icon_svg": {"file": "icon.svg"},
  "icon_bg_class": "bg-blue-500/20",
  "presentation": {
    "tagline": "Search Example from a Sprite without putting your key on it.",
    "setup": "Create an API key at example.com/settings/api-keys.",
    "notices": [
      {"title": "Billing", "body": "Saving or testing a key reads your account; searches use your Example credits."},
      {"title": "Scope", "body": "Only `POST /v1/search` and `GET /v1/items/:id` are forwarded."}
    ],
    "mark_svg": {"file": "mark.svg"}
  }
}
